  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@types/mocha", "@wdio/globals/types", "expect-webdriverio"]
  },
  "include": ["**/*.ts"]
}
